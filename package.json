{
  "name": "bot-arena",
  "private": true,
  "version": "0.1.0",
  "description": "Build a robot from parts, program it in real Python, send it into arenas.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:site": "rm -rf _site && mkdir -p _site/bot-areana && cp -r dist _site/bot-areana/main && cp -r dist _site/bot-areana/v0.1.0 && node scripts/pages-index.mjs _site/bot-areana && vite preview --outDir _site",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.8",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@lezer/python": "1.1.19",
    "idb": "8.0.4",
    "lz-string": "1.5.0",
    "phaser": "3.90.0",
    "pyodide": "314.0.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "fake-indexeddb": "6.2.8",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
